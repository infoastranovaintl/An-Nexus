# Optional: override the base-station BLE name filter used during device discovery.
VITE_BLE_MASTER_NAME=AN-FOREST-MASTER

# Optional: live gateway WebSocket endpoint (base station bridge / mesh gateway).
# Defaults to ws://localhost:8080 when unset.
# VITE_WS_URL=ws://192.168.1.50:8080

# Optional: default map center for the site map view.
VITE_MAP_LAT=27.7172
VITE_MAP_LNG=85.324
