{
  "name": "hydropower",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tiles:fetch": "node scripts/fetch-tiles.mjs",
    "tiles:fetch:site": "node scripts/fetch-tiles.mjs --lat 28.6139 --lng 77.209 --zmin 8 --zmax 15 --radius 10",
    "serve": "node server/index.mjs",
    "serve:build": "npm run build && node server/index.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.9.4",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet-relief": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.4",
    "@types/w3c-web-serial": "^1.0.7",
    "@types/web-bluetooth": "^0.0.21",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "ws": "^8.18.3"
  }
}
